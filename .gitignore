# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Secrets and local credentials (never publish to GitHub)
.env
.env.*
*.pem
*.key
*.p12
*.pfx
.npmrc
.replit
credentials*.json
service-account*.json

# Private workspace context and uploaded conversations
.agents/
attached_assets/
replit.md
.bolt/

# Runtime user data (not application source)
/bot/*.json
!/bot/package.json
!/bot/package-lock.json

# Logs, caches, temporary files and local databases
*.log
*.log.*
*.tmp
*.bak
*.sqlite
*.sqlite3
*.db
__pycache__/
*.pyc
.pytest_cache/
.turbo/
.vite/
coverage/
logs/
temp/

# Local deployment evidence, not application source
/bolt-backend/releases/**/baseline/

# Contains key-shaped test literals rejected by GitHub secret protection
/bolt-backend/server/test/checkout.test.cjs

# Encrypted runtime memory and backups are private, too.
eli-memory-private/
*.memory-backup
*.memory-plan
*.memory-export

