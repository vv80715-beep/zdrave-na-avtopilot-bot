{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Eli Mini App read-only profile progress response",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "window", "profile", "progress"],
  "properties": {
    "mode": {
      "type": "string",
      "const": "read_only"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "days"],
      "properties": {
        "from": { "type": "string", "format": "date" },
        "to": { "type": "string", "format": "date" },
        "days": { "type": "integer", "const": 7 }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weeklyMovementGoalDays"],
      "properties": {
        "weeklyMovementGoalDays": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 7
        }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activeDays",
        "denominator",
        "goalPercent",
        "averageSleepHours",
        "averageEnergy",
        "energyByDay",
        "recordsIncluded"
      ],
      "properties": {
        "activeDays": { "type": "integer", "minimum": 0, "maximum": 7 },
        "denominator": { "type": "integer", "const": 7 },
        "goalPercent": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "averageSleepHours": {
          "type": ["number", "null"],
          "minimum": 0.1,
          "maximum": 24
        },
        "averageEnergy": {
          "type": ["number", "null"],
          "minimum": 1,
          "maximum": 10
        },
        "energyByDay": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["date", "energy"],
            "properties": {
              "date": { "type": "string", "format": "date" },
              "energy": {
                "type": ["integer", "null"],
                "minimum": 1,
                "maximum": 10
              }
            }
          }
        },
        "recordsIncluded": { "type": "integer", "minimum": 0, "maximum": 7 }
      }
    }
  }
}
